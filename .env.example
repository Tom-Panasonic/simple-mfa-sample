# このファイルを .env にコピーして値を埋める（.env は Git 管理外）

# デプロイ先
AWS_PROFILE=your-profile
AWS_REGION=ap-northeast-1
STACK_NAME=simple-mfa-sample

# 書き込みに MFA が必須のアカウントだけ設定する（node scripts/with-mfa.mjs で使う）
# MFA_SERIAL=arn:aws:iam::123456789012:mfa/your-device

# SES で検証済みの送信元メールアドレス
MAIL_FROM=sender@example.com

# 登録画面で使う管理用キーと、トークン署名・認証コードのハッシュに使う秘密値（どちらも32文字以上）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=
APP_SECRET=

# npm run seed で登録する初期ユーザー
SEED_LOGIN_ID=user@example.com
SEED_PASSWORD=
SEED_MFA_EMAIL=user@example.com
