{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/authService.test.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/test/authService.test.mjs && node --test dist/test/authService.test.mjs",
    "build": "tsc --noEmit && esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --minify --outfile=dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/client-sesv2": "3.1154.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
